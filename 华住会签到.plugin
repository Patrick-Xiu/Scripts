#!name = 华住会新版签到
#!desc = 自动保存签到 Cookie，每天 06:05 签到。首次启用后进入华住会 APP 签到页获取凭据；需要开启 MITM 并信任证书。
#!date = 2026-10-31

[Script]
http-request ^https:\/\/appgw\.huazhu\.com\/game\/sign_(?:in|header)(?:\?|$) script-path=https://raw.githubusercontent.com/Patrick-Xiu/Scripts/main/hzhqd.js, requires-body=false, timeout=10, tag=华住会获取签到凭据, enable=true
cron "5 6 * * *" script-path=https://raw.githubusercontent.com/Patrick-Xiu/Scripts/main/hzhqd.js, timeout=30, tag=华住会每日签到, enable=true

[Mitm]
hostname = appgw.huazhu.com
